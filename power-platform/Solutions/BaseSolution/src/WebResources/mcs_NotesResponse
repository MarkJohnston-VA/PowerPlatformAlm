    <script>
        (function() {
            var selectedUid;
            var initialCall = true; $.ajaxSetup({ beforeSend: function (xhr) { xhr.setRequestHeader('Ocp-Apim-Subscription-Key', '88784cf9396e41dab087c90a5da0c2c1');  xhr.setRequestHeader('Ocp-Apim-Subscription-Key-E', '88784cf9396e41dab087c90a5da0c2c1');  xhr.setRequestHeader('Ocp-Apim-Subscription-Key-S', '88784cf9396e41dab087c90a5da0c2c1'); }});

            // Updates the selected row
            function updateSelectedItems() {
                if (initialCall) {
                    initialCall = false;
                } else {
                    $("#DataGrid").DataTable().draw('page');
                    $("tr.selectedItem").removeClass("selectedItem");
                }
                $("#" + selectedUid).addClass("selectedItem");
            }

            // Checks the row object to get the UID
            function checkForSelectedItem(row) {
                if (row) {
                    selectedUid = $(row).get(0).id;
                    updateSelectedItems();
                } else {
                    if (!selectedUid) {
                        // Sets the default selected row to the first item on the page
                        $("#DataGrid tbody tr:first-of-type td.json").click();
                    } else {
                        updateSelectedItems();
                    }
                }
            }

            // Display note details in the right pane when clicking on the row, except first cell
            $("#DataGrid > tbody > tr > td:not(td:nth-child(2))").click(function(event) {
                var row = $(event.target).parent();
                checkForSelectedItem(row);
                var json = $(row).find("td.json").text();
                detailPaneLoader(json, 1);
            });

            // Display addendum details if clicking on the addendum cell
            $("td.addendum").click(function(event) {
                // Check if click triggered from text or icon
                if (event.target.getAttribute("data-json")) {
                    var json = event.target.getAttribute("data-json");
                } else {
                    var json = $(event.target).parents("td.addendum").attr("data-json");
                }
                var row = $(this).parents("table").parents("tr");
                event.stopPropagation();

                // Selects the row of the containing addendum element
                checkForSelectedItem(row);
                detailPaneLoader(json, 2);

                // Closing open addendum grid if open
                if (event.target.parentElement.classList.contains('addendum')
                    || event.target.classList.contains('addendum')) {
                    var openGrid = document.querySelector('.open');
                    openGrid.classList.remove('open');
                }
            });

            // Details pane opener
            function detailPaneLoader(jsonPayload, noteType) {

                // Checks if the jsonPayload has a value otherwise, does not proceed
                if (jsonPayload.length > 0 && noteType) {

                    // Resets the contents of the details pane
                    $("#detailTitle").text('');
                    $("#rightPaneContent").html('<h4 id="loadingTitle">Loading ...</h4>');

                    // Adds and removes buttons to details pane, depending on noteType (1=Note, 2=Addendum)
                    if (noteType == 1) {
                        $("#btnCreateAddend").removeClass("hidden");
                        $("#btnNotesSigner").removeClass("hidden");
                        $("#btnAddSigner").addClass("hidden");
                    } else if (noteType == 2) {
                        $("#btnCreateAddend").addClass("hidden");
                        $("#btnNotesSigner").addClass("hidden");
                        $("#btnAddSigner").removeClass("hidden");
                    }

                    // Performs a post request to get the contents of the partial

                    var href = 'https://dev.integration.d365.va.gov/veis/Notes/2.0/FTPCRM/1012901140V218059'.split("?");

                    var url = href[0];
                    var trailingSlash = "/";
                    if (url.substr(-1) !== trailingSlash) { // last char is NOT a slash
                        url += trailingSlash; // add a slash
                    }
                    url += "detail"; // URL should not be something like /Orders/latest/detail


                    var clientName = $('#inputClientName').val();
                   

                    var dataObj = {};
                    dataObj.detail = jsonPayload;
                    dataObj.id = noteType;
                    if (clientName != null && clientName.length > 1) {
                        dataObj.clientName = clientName; 
                    }

                    $.post(url,
                        dataObj,
                        function(response) {
                            var htmlPartial = $(response);
                            $("#rightPaneContent").html(htmlPartial);
                        });
                }
            }

            // Listens for paging events
            $('#DataGrid').on('page.dt',
                function() {
                    checkForSelectedItem();
                });
				
			$(".btnAddRequest").on('click', function (event) {
				event.preventDefault();

				var uId = $(this).attr('id');
				var noteId = uId.substring(1);

				var trclassName = document.getElementById(noteId).className;

				ToggleRowClassName(trclassName, noteId);

				if (noteId.length > 0) {

					var addRequest = {
						buttonClicked: "btnAddRequest",
						data: {
							noteUId: noteId,
							Caller: "ADDREQ"
						}
					}
					parent.postMessage(addRequest, "*");
				}
			});

			$(".btnRemRequest").on('click', function (event) {
				event.preventDefault();

				var uId = $(this).attr('id');
				var noteId = uId.substring(1);
				
				var trclassName = document.getElementById(noteId).className;

				ToggleRowClassName(trclassName, noteId);

				if (noteId.length > 0) {

					var removeRequest = {
						buttonClicked: "btnRemRequest",
						data: {
							noteUId: noteId,
							Caller: "DELREQ"
						}
					}
					parent.postMessage(removeRequest, "*");
				}
			});

            // Overwrite the function listens for page length change events
            lengthChange = function() {
                checkForSelectedItem();
            };

            // Calls the function to select the first item on initial load
            checkForSelectedItem();
        })();

        function ToggleRowClassName(tdClass, noteId) {

            var toggle = "A";
            $("#" + noteId).removeClass(tdClass);

            switch (tdClass) {
                case "Add odd":
                    tdClass = "Rem odd";
                    break;
                case "Add even":
                    tdClass = "Rem even";
                    break;
                case "Rem odd":
                    tdClass = "Add odd";
                    toggle = "R";
                    break;
                case "Rem even":
                    tdClass = "Add even";
                    toggle = "R";
                    break;

                default:
            }

            if (toggle === "A") {
                $('#R' + noteId).removeClass('hidden');
                $('#A' + noteId).addClass('hidden');
            } else {
                $('#A' + noteId).removeClass('hidden');
                $('#R' + noteId).addClass('hidden');
            }

            $("#" + noteId).addClass(tdClass);

            return tdClass;
        }
    </script>
