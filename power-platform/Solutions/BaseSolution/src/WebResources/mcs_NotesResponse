    <script type="text/javascript">
        // modify page before the data grid initializes
        // by calling view custom javascript function
        var pre = function preDataGridInit() {
            if (typeof preGridInitialize === 'function') {
                preGridInitialize();
            }
        }

        // modify page after the data grid initializes
        // by calling view custom javascript function
        var post = function postDataGridInit() {
            if (typeof postGridInitialize === 'function') {
                postGridInitialize();
            }
        }

        // data grid initialization
        var gridInit = function dataGridInit() {
            $(document).ready(function () {
                $('#startDate').datepicker({ format: 'mm/dd/yyyy' });
                $('#endDate').datepicker({ format: 'mm/dd/yyyy' });

                $('#DataGrid').DataTable({
                    sDom: 'Rlftrip',
                    paging: true,
                    autoWidth: false,
                    initComplete: function () {
                        this.api().columns().every(function () {
                            var column = this;
                            var select = $('<select><option value=""></option></select>')
                                .appendTo($(column.footer()).empty())
                                .on('change', function () {
                                    var val = $.fn.dataTable.util.escapeRegex(
                                        $(this).val()
                                    );
                                    val = val.replace(/<.+>/, "").trim();
                                    column
                                        .search(val ? '^' + val + '$' : '', true, false)
                                        .draw();
                                });
                            column.data().unique().sort().each(function (d, j) {
                                d = d.replace(/<.+>/, "").trim();
                                select.append('<option value="' + d + '">' + d + ' </option>')
                            });
                        });
                    },

                });
            });
        }

        // populate page load queue
        var pageLoadQueue = [pre, gridInit, post];

        var lengthChange = function() { };

        $(document).ready(function () {

        	//eliminate global double clicks on data rows
        	$("#DataGrid tbody tr").dblclick(function (e) {
        		//do nothing
        		e.preventDefault();
        		e.stopPropagation();
        	});

            // initial web part page
            while (pageLoadQueue.length) {
                pageLoadQueue.shift().call();
            }
            
            // keep  Show # of Entries and Search on the same row
            setTimeout(function () {
                $("#DataGrid_wrapper").addClass("rows");
                $("#DataGrid_length").addClass("col-xs-6");
                $("#DataGrid_filter").addClass("text-right");
                $("#DataGrid_info").addClass("col-xs-4");
                $("#DataGrid_pagination").addClass("col-xs-8");
                $("#DataGrid_length").change(function() {lengthChange();});
            }, 10);
        });

        //Modal View. This is generic for all the web parts . 

        function loadModalDetail(webPartName, data, id) {
            var html = '<div id="whiteBox"></div>';
            $("#title").html(webPartName + ' Detail');

            var href = 'https://dev.integration.d365.va.gov/veis/Notes/2.0/FTPCRM/1012901140V218059'.split("?");

            var url = href[0];
            var trailingSlash = "/";
            if (url.substr(-1) !== trailingSlash) { // last char is NOT a slash
                url += trailingSlash; // add a slash
            }
            url += "detail"; // URL should be something like /Orders/1.0/detail
            var clienturlParam = "";
            if ($('#inputClientName').length > 0) {
                var clientName = $('#inputClientName').val();
                clienturlParam = "&clientName=" + clientName;
            }

            $("#whiteBox").remove();
            $.ajax({
                url: url,  beforeSend: function (xhr) { xhr.setRequestHeader('Ocp-Apim-Subscription-Key', '88784cf9396e41dab087c90a5da0c2c1');  xhr.setRequestHeader('Ocp-Apim-Subscription-Key-E', '88784cf9396e41dab087c90a5da0c2c1');  xhr.setRequestHeader('Ocp-Apim-Subscription-Key-S', '88784cf9396e41dab087c90a5da0c2c1'); },
                type: 'POST',
                data: "detail=" + param + "&id=" + id + clienturlParam,
                cache: false,
                success: function (htmlResult) {
	                $("#detailContent").empty();
                    $("#detailContent").append(html);
                    $("#whiteBox").append(htmlResult);
                    $('#hdrDialog').modal('show');
                },
                error: function (data) {
                    alert(data.errorMsg + "Data not showing");
                }
            });
        }


        $(document).on('click', '#btnModalClose', function (e) {
            e.preventDefault();
            $("#whiteBox").remove();
            $('#hdrDialog').modal('hide');
        });

        //Modal view code ends here

        function bindGridRowClick(webPartName) {
            // launch modal view on row double click
            $("#DataGrid tbody tr").dblclick(function (event) {
                var row = $(this).find('td:last').text();
                loadModalDetail(webPartName, row);
            });
        }

        function postPageLoad() {
            hideNoFilter();
        }

        function hideNoFilter(){
            $(".nofilter > select").hide();
        }
    </script>


    
