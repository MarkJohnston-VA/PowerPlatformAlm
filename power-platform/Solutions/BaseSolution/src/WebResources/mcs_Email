        CommCare.Shared.GetFormContext(context);
        //CommCare.Shared.HashHandler();
        //console.log("pastHashHandler");
        CommCare.Shared.SetChildContext(CommCare.Shared.FormContext, "WebResource_RequestsByTinSearch");
    }

})();