              "metadata": {
                "operationMetadataId": "365ecb63-3223-495e-8333-228b853482e1"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_2",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "calendars",
                  "$filter": "name eq 'Community Care Service Calendar'",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Apply_to_each_2": {
              "foreach": "@outputs('Get_Community_Care_Service_Calendar')?['body/value']",
              "actions": {
                "Apply_to_each_3": {
                  "foreach": "@outputs('Get_Action_Items')?['body/value']",
                  "actions": {
                    "Perform_an_unbound_action_(Calculate_Business_Days)": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "6ca6ffe6-9fd5-4485-8866-b972783fe15d"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps_2",
                          "operationId": "PerformUnboundAction",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "actionName": "mcs_CalculateBusinessDays",
                          "item/Calendar/calendarid": "@items('Apply_to_each_2')?['calendarid']",
                          "item/StartDate": "@utcNow()",
                          "item/EndDate": "@items('Apply_to_each_3')?['mcs_originatorduedate']"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Update_Action_Item's_Days_Remaining_field": {
                      "runAfter": {
                        "Perform_an_unbound_action_(Calculate_Business_Days)": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "7e2f6665-e5b7-4a6f-93d4-eff4e0ac6111"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps_2",
                          "operationId": "UpdateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "mcs_trackers",
                          "recordId": "@items('Apply_to_each_3')?['mcs_trackerid']",
                          "item/mcs_daysremaining": "@outputs('Perform_an_unbound_action_(Calculate_Business_Days)')?['body/BusinessDays']"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "33f32557-6ebc-44d1-91b3-52d96c72f2e4"
                  },
                  "type": "Foreach"
                }
              },
              "runAfter": {
                "Get_Community_Care_Service_Calendar": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "f13c9a49-c587-4a01-a6f7-f7fa1681a219"
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Create_new_Flow_Activity_Status_Morning": [
