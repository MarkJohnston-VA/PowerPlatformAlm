                    },
                    "parameters": {
                      "entityName": "contacts",
                      "$filter": "bah_searchtype_text eq 'CREATEUPDATEMVI' and bah_ssn_text eq '@{items('Apply_to_each')?['crme_ssn']}' and firstname eq '@{items('Apply_to_each')?['crme_firstname']}' and lastname eq '@{items('Apply_to_each')?['crme_lastname']}'  and bah_source_text eq 'MVI'  and statecode eq 0 and bah_dob_date eq @{variables('DOB')}",
                      "$orderby": "createdon desc"
                    },
                    "authentication": {
                      "type": "Raw",
                      "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
