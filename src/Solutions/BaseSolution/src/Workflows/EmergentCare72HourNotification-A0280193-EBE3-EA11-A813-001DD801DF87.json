              "required": []
            }
          }
        }
      },
      "actions": {
        "Retrieve_active_queue_items_older_than_72_hours_related_to_requests": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "queueitems",
              "fetchXml": "<fetch top=\"5\" >\n  <entity name=\"queueitem\" >\n    <attribute name=\"objectid\" />\n    <order attribute=\"createdon\" descending=\"true\" />\n    <filter type=\"and\" >\n      <condition attribute=\"createdon\" operator=\"olderthan-x-hours\" value=\"72\" />\n      <condition attribute=\"statecode\" operator=\"eq\" value=\"0\" />\n      <condition attribute=\"objectidtypecode\" operator=\"eq\" value=\"112\" />\n    </filter>\n  </entity>\n</fetch>"
            },
            "authentication": {
              "type": "Raw",
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
            }
          }
        },
        "For_each_queue_item": {
          "foreach": "@outputs('Retrieve_active_queue_items_older_than_72_hours_related_to_requests')?['body/value']",
          "actions": {
            "Get_associated_request": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "incidents",
                  "recordId": "@items('For_each_queue_item')?['_objectid_value']",
                  "$select": "statecode, mcs_caretype"
                },
                "authentication": {
                  "type": "Raw",
                  "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
                }
              }
            },
            "Condition": {
              "actions": {
                "Perform_a_bound_action": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "PerformBoundAction",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "queueitems",
                      "actionName": "Microsoft.Dynamics.CRM.mcs_EmergentCare72HourNotificationAction",
                      "recordId": "@items('For_each_queue_item')?['queueitemid']"
                    },
                    "authentication": {
                      "type": "Raw",
                      "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
                    }
                  }
                }
              },
              "runAfter": {
                "Get_associated_request": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@outputs('Get_associated_request')?['body/statecode']",
                      0
                    ]
                  },
                  {
                    "equals": [
                      "@outputs('Get_associated_request')?['body/mcs_caretype']",
                      803750002
                    ]
                  }
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Retrieve_active_queue_items_older_than_72_hours_related_to_requests": [
              "Succeeded"
            ]
          },
          "type": "Foreach"
        }
