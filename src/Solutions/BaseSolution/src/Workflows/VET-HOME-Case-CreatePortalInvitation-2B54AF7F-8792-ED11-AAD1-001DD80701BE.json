{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps_2": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mcs_sharedcommondataserviceforapps_7c6b2"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "VetHomePortalURL (mcs_VetHomePortalURL)": {
          "defaultValue": "https://vethome-dev.powerappsportals.us",
          "type": "String",
          "metadata": {
            "schemaName": "mcs_VetHomePortalURL"
          }
        },
        "VET-HOME Queue for Sending Emails (mcs_VETHOMEQueueforSendingEmails)": {
          "defaultValue": "3d7e328b-3b97-ed11-aad1-001dd80721cf",
          "type": "String",
          "metadata": {
            "schemaName": "mcs_VETHOMEQueueforSendingEmails"
          }
        }
      },
      "triggers": {
        "VET-HOME_Case_Send_Invitation_Set_to_True": {
          "metadata": {
            "operationMetadataId": "5ab665d6-afd6-4ad2-b17c-a6207630a830"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_2",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "mcs_vethomecase",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "mcs_sendportalinvitation",
              "subscriptionRequest/filterexpression": "mcs_sendportalinvitation eq true"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Initialize_Flow_ID_variable": {
          "runAfter": {
            "Flow_Start_Time": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1a62cdfd-7f5e-4e18-baa7-73b027bd1af5"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Flow ID",
                "type": "string",
                "value": "@{workflow()?['name']}"
              }
            ]
          },
          "description": "Creates Flow ID Variable used to track Flow Status"
        },
        "Flow_Start_Time": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "44e6921c-b92a-4be5-9c1c-524379af6ce6"
          },
          "type": "Expression",
          "kind": "CurrentTime",
          "inputs": {}
        },
        "Initialize_Flow_Display_Name_variable": {
          "runAfter": {
            "Initialize_Flow_ID_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "8fc33c19-cade-46ad-89a3-53fdab5e521b"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Flow Display Name",
                "type": "string",
                "value": "@{workflow()?['tags']['flowDisplayName']}"
              }
            ]
          },
          "description": "Creates Flow Display Name Variable used to track Flow Status"
        },
        "Initialize_Flow_URL_variable": {
          "runAfter": {
            "Initialize_Flow_Display_Name_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "4497aee6-086f-4c9d-a3fe-72016645c169"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Flow URL",
                "type": "string",
                "value": "@{concat('https://gov.flow.microsoft.us/manage/environments/', workflow()?['tags']['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']['name'])}"
              }
            ]
          },
          "description": "Creates Flow URL variable used to Track Flow Status"
        },
        "Initialize_Run_ID_variable": {
          "runAfter": {
            "Initialize_Flow_URL_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "77d837a7-6dfa-4956-a256-01829fa71bd2"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Run ID",
                "type": "string",
                "value": "@{workflow()?['run']['name']}"
              }
            ]
          },
          "description": "Creates flow Run ID variable used to track Run ID"
        },
        "Create_new_Flow_Activity_Status_Morning": {
          "runAfter": {
            "Initialize_Invitation_URL": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "173fdd54-0742-433d-8539-7bb349f79dde"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_2",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mcs_flowactivitystatuses",
              "item/mcs_flowname": "@variables('Flow Display Name')",
              "item/mcs_flowexecutionurl": "@variables('Flow URL')",
              "item/mcs_flowid": "@variables('Flow ID')",
              "item/statuscode": 1,
              "item/mcs_runid": "@variables('Run ID')",
              "item/mcs_startdatetime": "@body('Flow_Start_Time')",
              "item/statecode": 0
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Creates new record in Flow Activity Statuses entity to track flow runs."
        },
        "Scope": {
          "actions": {
            "Create_Invitation": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "f688a2d3-2948-45a5-9105-3b74547b6365"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_2",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "adx_invitations",
                  "item/adx_name": "@triggerOutputs()?['body/mcs_name']",
                  "item/adx_type": 756150000,
                  "item/adx_inviteContact@odata.bind": "contacts(@{triggerOutputs()?['body/_mcs_veteranid_value']})"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Create_Email": {
              "runAfter": {
                "Get_Contact": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "88cf2d73-f45b-4664-bd92-c177429a39ab"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_2",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "emails",
                  "item/activitypointer_activity_parties": [
                    {
                      "participationtypemask": 2,
                      "partyid@odata.bind": "contacts(@{triggerOutputs()?['body/_mcs_veteranid_value']})"
                    },
                    {
                      "participationtypemask": 1,
                      "partyid@odata.bind": "queues(@{parameters('VET-HOME Queue for Sending Emails (mcs_VETHOMEQueueforSendingEmails)')})"
                    }
                  ],
                  "item/description": "Dear @{outputs('Get_Contact')?['body/firstname']} @{outputs('Get_Contact')?['body/lastname']},\n<br>\n<br>\nYou have been invited to the Veterans Exposure Team – Health Outcomes Military Exposures (VET-HOME) Portal. To accept your invitation, please click the link below. From there, click the register button. You will be given multiple options to sign in to the VET-HOME Portal.\n<br>\n <br>\n<a href=\"@{variables('InvitationURL')}@{outputs('Create_Invitation')?['body/adx_invitationcode']}\">VET-HOME Portal Registration</a>\n<br>\n<br>\nIf the invitation code is blank, copy and paste the Invitation Code from below and click the register button.\n<br>\n<br>\n Invitation Code:\n<br>@{outputs('Create_Invitation')?['body/adx_invitationcode']}\n<br>\n<br>\nIf you do not already have an account with any of the sign-in partners provided, please follow the link on the page to register for a sign-in partner.\n<br>\n<br>\nOnce you have signed in to the VET-HOME Portal, you will be able to:\n<br>\n<ul>\n  <li>View your Portal Messages</li>\n  <li>Upload documents and reply to messages through the Message Center</li>\n  <li>Submit an inquiry through Contact Us</li>\n</ul>\nSincerely,\n<br>\nVeterans Exposure Team-Health Outcomes Military Exposures (VET-HOME) Intake Center\n<br>\nDepartment of Veterans Affairs\n<br>\nPhone Number 1-833-633-8846\n<br>\nMonday to Friday 9:00 AM - 7:30 PM ET",
                  "item/regardingobjectid_mcs_vethomecase_email@odata.bind": "/mcs_vethomecases/@{triggerOutputs()?['body/mcs_vethomecaseid']}",
                  "item/subject": "VET-HOME Portal Invitation"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Perform_a_bound_action": {
              "runAfter": {
                "Create_Email": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "9139fd89-de89-4cbc-816e-8b0361e34607"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_2",
                  "operationId": "PerformBoundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "emails",
                  "actionName": "Microsoft.Dynamics.CRM.SendEmail",
                  "recordId": "@outputs('Create_Email')?['body/activityid']",
                  "item/IssueSend": true
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Get_Contact": {
              "runAfter": {
                "Create_Invitation": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "43351e92-c5ad-488a-a2f2-dbefc61f9d59"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_2",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "contacts",
                  "recordId": "@triggerOutputs()?['body/_mcs_veteranid_value']",
                  "$select": "emailaddress1,firstname, lastname"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Create_new_Flow_Activity_Status_Morning": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "af3aef12-c159-4d66-b994-a1b0d5a5415f"
          },
          "type": "Scope"
        },
        "Current_time_Failed": {
          "runAfter": {
            "Scope": [
              "Skipped",
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "d873a0ad-0c99-4341-a515-554b7948c7da"
          },
          "type": "Expression",
          "kind": "CurrentTime",
          "inputs": {}
        },
        "Update_with_Success_Status": {
          "runAfter": {
            "Current_time_Successful": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "90751a53-eaf5-4203-bd2a-0de603453eb2"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_2",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mcs_flowactivitystatuses",
              "recordId": "@outputs('Create_new_Flow_Activity_Status_Morning')?['body/mcs_flowactivitystatusid']",
              "item/mcs_enddatetime": "@body('Current_time_Successful')",
              "item/statuscode": 153190007
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Update the corresponding Flow Activity Status record depending on if Scope step completed successfully.  Update the End Date Time with current time, Flow Run Status to Success.."
        },
        "Current_time_Successful": {
          "runAfter": {
            "Scope": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "b41e3bd9-edcd-463e-9371-7026ac9d298a"
          },
          "type": "Expression",
          "kind": "CurrentTime",
          "inputs": {}
        },
        "Filter_Error_Array": {
          "runAfter": {
            "Current_time_Failed": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "8fd80e3d-b708-463c-a4d1-239eca4a7d83"
          },
          "type": "Query",
          "inputs": {
            "from": "@result('Scope')",
            "where": "@equals(item()?['status'], string('Failed'))"
          },
          "description": "Filter workflow object based on Failed Status to retrieve Error Message."
        },
        "Flow_Error_Message": {
          "runAfter": {
            "Filter_Error_Array": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "49924d66-db09-45ad-a544-ce5300b477d5"
          },
          "type": "Compose",
          "inputs": "@body('Filter_Error_Array')[0]?['outputs']?['body']?['error/message']",
          "description": "Obtain Error Message from workflow object"
        },
        "Update_a_row_with_Failed_Status": {
          "runAfter": {
            "Flow_Error_Message": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "04a53181-61c9-40b9-b54d-5a666255e4b7"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_2",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mcs_flowactivitystatuses",
              "recordId": "@outputs('Create_new_Flow_Activity_Status_Morning')?['body/mcs_flowactivitystatusid']",
              "item/mcs_enddatetime": "@body('Current_time_Failed')",
              "item/mcs_errormessage": "@string(outputs('Flow_Error_Message'))",
              "item/statuscode": 153190004
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Update the corresponding Flow Activity Status record due to one or more steps failing in the Scope above.   Update the Start Date field to Current time, Flow Run Status to Error and the Error Message field with the error retrieved from previous step."
        },
        "Initialize_Invitation_URL": {
          "runAfter": {
            "Initialize_Run_ID_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "388ba886-1ccd-4cbf-ab35-e9a232abeac0"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "InvitationURL",
                "type": "string",
                "value": "@{parameters('VetHomePortalURL (mcs_VetHomePortalURL)')}/register/?returnurl=%2f&invitation="
              }
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}