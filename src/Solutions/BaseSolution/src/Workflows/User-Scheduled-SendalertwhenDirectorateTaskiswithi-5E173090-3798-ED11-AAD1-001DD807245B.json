                "parameters": {
                  "entityName": "systemusers",
                  "fetchXml": "<fetch version=\"1.0\" output-format=\"xml-platform\" mapping=\"logical\" distinct=\"true\">\n  <entity name=\"systemuser\">\n    <attribute name=\"fullname\" />\n    <attribute name=\"title\" />\n    <attribute name=\"address1_telephone1\" />\n    <attribute name=\"businessunitid\" />\n    <attribute name=\"positionid\" />\n    <attribute name=\"domainname\" />\n    <attribute name=\"internalemailaddress\" />\n    <attribute name=\"systemuserid\" />\n    <order attribute=\"fullname\" descending=\"false\" />\n    <filter type=\"and\">\n      <condition attribute=\"isdisabled\" operator=\"eq\" value=\"0\" />\n      <condition attribute=\"accessmode\" operator=\"ne\" value=\"3\" />\n    </filter>\n    <link-entity name=\"mcs_taskertask\" from=\"mcs_assignedto\" to=\"systemuserid\" link-type=\"inner\" alias=\"as\">\n      <filter type=\"and\">\n        <condition attribute=\"statecode\" operator=\"eq\" value=\"0\" />\n        <filter type=\"or\">\n          <condition attribute=\"mcs_directorateduedate\" operator=\"next-x-days\" value=\"2\" />\n          <condition attribute=\"mcs_directorateduedate\" operator=\"last-x-years\" value=\"10\" />\n        </filter>\n      </filter>\n    </link-entity>\n    <link-entity name=\"systemuserroles\" from=\"systemuserid\" to=\"systemuserid\" visible=\"false\" intersect=\"true\">\n      <link-entity name=\"role\" from=\"roleid\" to=\"roleid\" alias=\"at\">\n        <filter type=\"and\">\n          <condition attribute=\"roleid\" operator=\"in\">\n            <value uiname=\"System Administrator\" uitype=\"role\">{DCECED69-7064-E711-8111-1458D04E2F18}</value>\n            <value uiname=\"CRAM - 16 IVC Front Office\" uitype=\"role\">{5FCB129C-AB6B-EB11-A812-001DD800AC9E}</value>\n            <value uiname=\"CRAM - Directorate\" uitype=\"role\">{C0EE6B57-AC6B-EB11-A812-001DD800A64F}</value>\n            <value uiname=\"CRAM - Executive Directorate\" uitype=\"role\">{19386163-AC6B-EB11-A812-001DD800A64F}</value>\n          </condition>\n        </filter>\n      </link-entity>\n    </link-entity>\n  </entity>\n</fetch>"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
