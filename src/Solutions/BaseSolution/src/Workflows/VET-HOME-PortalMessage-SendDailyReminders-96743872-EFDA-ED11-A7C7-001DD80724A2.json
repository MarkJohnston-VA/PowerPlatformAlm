        "connection": {
          "connectionReferenceLogicalName": "mcs_sharedcommondataserviceforapps_7c6b2"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "VET-HOME Queue for Sending Emails (mcs_VETHOMEQueueforSendingEmails)": {
          "defaultValue": "3d7e328b-3b97-ed11-aad1-001dd80721cf",
          "type": "String",
          "metadata": {
            "schemaName": "mcs_VETHOMEQueueforSendingEmails"
          }
        },
        "VetHomePortalURL (mcs_VetHomePortalURL)": {
          "defaultValue": "https://vethome-dev.powerappsportals.us",
          "type": "String",
          "metadata": {
            "schemaName": "mcs_VetHomePortalURL"
          }
        },
        "SecondReminder (mcs_SecondReminder)": {
          "defaultValue": "2",
          "type": "String",
          "metadata": {
            "schemaName": "mcs_SecondReminder",
            "description": "this is second reminder for portal message if user has not responded."
          }
        },
        "FirstReminder (mcs_FirstReminder)": {
          "defaultValue": "1",
          "type": "String",
          "metadata": {
            "schemaName": "mcs_FirstReminder",
            "description": "this is first reminder for portal message"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "startTime": "2023-04-15T05:00:00Z"
          },
          "metadata": {
            "operationMetadataId": "37e47585-04b8-49d1-b014-0d85ce2da1d4"
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "Initialize_Flow_ID_variable": {
          "runAfter": {
            "Flow_Start_Time": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1a62cdfd-7f5e-4e18-baa7-73b027bd1af5"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Flow ID",
                "type": "string",
                "value": "@{workflow()?['name']}"
              }
            ]
          },
          "description": "Creates Flow ID Variable used to track Flow Status"
        },
        "Flow_Start_Time": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "44e6921c-b92a-4be5-9c1c-524379af6ce6"
          },
          "type": "Expression",
          "kind": "CurrentTime",
          "inputs": {}
        },
        "Initialize_Flow_Display_Name_variable": {
          "runAfter": {
            "Initialize_Flow_ID_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "8fc33c19-cade-46ad-89a3-53fdab5e521b"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Flow Display Name",
                "type": "string",
                "value": "@{workflow()?['tags']['flowDisplayName']}"
              }
            ]
          },
          "description": "Creates Flow Display Name Variable used to track Flow Status"
        },
        "Initialize_Flow_URL_variable": {
          "runAfter": {
            "Initialize_Flow_Display_Name_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "4497aee6-086f-4c9d-a3fe-72016645c169"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Flow URL",
                "type": "string",
                "value": "@{concat('https://gov.flow.microsoft.us/manage/environments/', workflow()?['tags']['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']['name'])}"
              }
            ]
          },
          "description": "Creates Flow URL variable used to Track Flow Status"
        },
        "Initialize_Run_ID_variable": {
          "runAfter": {
            "Initialize_Flow_URL_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "77d837a7-6dfa-4956-a256-01829fa71bd2"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Run ID",
                "type": "string",
                "value": "@{workflow()?['run']['name']}"
              }
            ]
          },
          "description": "Creates flow Run ID variable used to track Run ID"
        },
        "Create_new_Flow_Activity_Status_Monitoring": {
          "runAfter": {
            "Initialize_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "173fdd54-0742-433d-8539-7bb349f79dde"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mcs_flowactivitystatuses",
              "item/mcs_flowname": "@variables('Flow Display Name')",
              "item/mcs_flowexecutionurl": "@variables('Flow URL')",
              "item/mcs_flowid": "@variables('Flow ID')",
              "item/statuscode": 1,
              "item/mcs_runid": "@variables('Run ID')",
              "item/mcs_startdatetime": "@body('Flow_Start_Time')",
              "item/statecode": 0
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Creates new record in Flow Activity Statuses entity to track flow runs."
        },
        "Scope": {
          "actions": {
            "get_7_days_date": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "82b451c8-2c3b-46b3-8103-a373d73596d0"
              },
              "type": "Expression",
              "kind": "GetFutureTime",
              "inputs": {
                "interval": "@parameters('FirstReminder (mcs_FirstReminder)')",
                "timeUnit": "Day"
              }
            },
            "get_14_days_date": {
              "runAfter": {
                "Reminder_1_Date": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "79a41ad5-5635-4ab5-875a-cfc422bb3019"
              },
              "type": "Expression",
              "kind": "GetFutureTime",
              "inputs": {
                "interval": "@parameters('SecondReminder (mcs_SecondReminder)')",
                "timeUnit": "Day"
              }
            },
            "Retrieve_outbound_unread_portal_messages_from_last_14_days__": {
              "runAfter": {
                "Reminder_2_Date": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "18845e95-291e-4ec7-af8b-4c3bfd7e08b6"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "mcs_portalmessages",
                  "$filter": "(Microsoft.Dynamics.CRM.LastXDays(PropertyName='createdon',PropertyValue=14) and mcs_isviewed eq false and statuscode ne 2 and mcs_direction eq true)"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Apply_to_each": {
              "foreach": "@outputs('Retrieve_outbound_unread_portal_messages_from_last_14_days__')?['body/value']",
              "actions": {
                "Get_Message_created_on_date": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "b56eacd6-418b-4e80-9f90-e5aac53c99cf"
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "Create Date",
                    "value": "@items('Apply_to_each')?['createdon']"
                  }
                },
                "Condition": {
                  "actions": {
                    "Perform_a_bound_action_-_send_reminder_email": {
                      "runAfter": {
                        "Add_Email_Activity_for_reminder": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "8a2cce60-ed78-4361-9b07-e47bfaa8674f"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps_1",
                          "operationId": "PerformBoundAction",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "emails",
                          "actionName": "Microsoft.Dynamics.CRM.SendEmail",
                          "recordId": "@outputs('Add_Email_Activity_for_reminder')?['body/activityid']",
                          "item/IssueSend": true
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Add_Email_Activity_for_reminder": {
                      "runAfter": {
                        "Get_Veteran_Record": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "a78d9c4b-c55a-43ba-865e-0f2362aa36b7"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps_1",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "emails",
                          "item/activitypointer_activity_parties": [
                            {
                              "participationtypemask": 2,
                              "partyid@odata.bind": "contacts(@{items('Apply_to_each')?['_mcs_veteran_value']})"
                            },
                            {
                              "participationtypemask": 1,
                              "partyid@odata.bind": "queues(@{parameters('VET-HOME Queue for Sending Emails (mcs_VETHOMEQueueforSendingEmails)')})"
                            }
                          ],
                          "item/description": "Dear   @{outputs('Get_Veteran_Record')?['body/firstname']} @{outputs('Get_Veteran_Record')?['body/lastname']}, \n<br>\n<br>\nYou  have a new message regarding case  @{outputs('Get_Case_record')?['body/mcs_casenumber']} on @{items('Apply_to_each')?['mcs_datesent']} .\n<br>\n<br>\nPlease login to the VET-HOME Portal to view your message.\n <br>\n<a href=\"@{parameters('VetHomePortalURL (mcs_VetHomePortalURL)')}/message-center/\">VET-HOME Portal Message Center</a>\n<br>\n<br>\nSincerely,\n<br>\nVeterans Exposure Team-Health Outcomes Military Exposures (VET-HOME) Intake Center\n<br>\nDepartment of Veterans Affairs\n<br>\nPhone Number 1-833-633-8846\n<br>\nMonday to  , day 9:00 AM - 7:30 PM ET ",
                          "item/regardingobjectid_mcs_vethomecase_email@odata.bind": "/mcs_vethomecases/@{items('Apply_to_each')?['_mcs_vethomecaseid_value']}",
                          "item/subject": "*Reminder* New message from VET-HOME Intake Center"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Get_Case_record": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "7347b224-11bd-45dc-aaa3-236447dd76a4"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps_1",
                          "operationId": "GetItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "mcs_vethomecases",
                          "recordId": "@items('Apply_to_each')?['_mcs_vethomecaseid_value']",
                          "$select": "mcs_casenumber"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Get_Veteran_Record": {
                      "runAfter": {
                        "Get_Case_record": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "0e26f160-08f0-4682-bc82-3e614afed5e7"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps_1",
                          "operationId": "GetItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "contacts",
                          "recordId": "@items('Apply_to_each')?['_mcs_veteran_value']",
                          "$select": "emailaddress1,firstname,lastname"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "runAfter": {
                    "Get_Message_created_on_date": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "or": [
                      {
                        "equals": [
                          "@substring(variables('Create Date'),0,10)",
                          "@outputs('Reminder_1_Date')"
                        ]
                      },
                      {
                        "equals": [
                          "@substring(variables('Create Date'),0,10)",
                          "@outputs('Reminder_2_Date')"
                        ]
                      }
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "5c8274e5-dfdb-4653-a03c-bc6e20f15f43"
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Retrieve_outbound_unread_portal_messages_from_last_14_days__": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "d270410d-94e6-4447-9432-7ba40325a0e4"
              },
              "type": "Foreach"
            },
            "Reminder_1_Date": {
              "runAfter": {
                "get_7_days_date": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "cfca762c-50fb-4778-937e-54db518c0f77"
              },
              "type": "Compose",
              "inputs": "@substring(body('get_7_days_date'),0,10)"
            },
            "Reminder_2_Date": {
              "runAfter": {
                "get_14_days_date": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "646db4a5-9954-49a2-99cd-5b1bebb6504e"
              },
              "type": "Compose",
              "inputs": "@substring(body('get_14_days_date'),0,10)"
            }
          },
          "runAfter": {
            "Create_new_Flow_Activity_Status_Monitoring": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "af3aef12-c159-4d66-b994-a1b0d5a5415f"
          },
          "type": "Scope"
        },
        "Current_time_Failed": {
          "runAfter": {
            "Scope": [
              "Skipped",
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "d873a0ad-0c99-4341-a515-554b7948c7da"
          },
          "type": "Expression",
          "kind": "CurrentTime",
          "inputs": {}
        },
        "Update_with_Success_Status": {
          "runAfter": {
            "Current_time_Successful": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "90751a53-eaf5-4203-bd2a-0de603453eb2"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mcs_flowactivitystatuses",
              "recordId": "@outputs('Create_new_Flow_Activity_Status_Monitoring')?['body/mcs_flowactivitystatusid']",
              "item/mcs_enddatetime": "@body('Current_time_Successful')",
              "item/statuscode": 153190007
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Update the corresponding Flow Activity Status record depending on if Scope step completed successfully.  Update the End Date Time with current time, Flow Run Status to Success.."
        },
        "Current_time_Successful": {
          "runAfter": {
            "Scope": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "b41e3bd9-edcd-463e-9371-7026ac9d298a"
          },
          "type": "Expression",
          "kind": "CurrentTime",
          "inputs": {}
        },
        "Filter_Error_Array": {
          "runAfter": {
            "Current_time_Failed": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "8fd80e3d-b708-463c-a4d1-239eca4a7d83"
          },
          "type": "Query",
          "inputs": {
            "from": "@result('Scope')",
            "where": "@equals(item()?['status'], string('Failed'))"
          },
          "description": "Filter workflow object based on Failed Status to retrieve Error Message."
        },
        "Flow_Error_Message": {
          "runAfter": {
            "Filter_Error_Array": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "49924d66-db09-45ad-a544-ce5300b477d5"
          },
          "type": "Compose",
          "inputs": "@body('Filter_Error_Array')[0]?['outputs']?['body']?['error/message']",
          "description": "Obtain Error Message from workflow object"
        },
        "Update_a_row_with_Failed_Status": {
          "runAfter": {
            "Flow_Error_Message": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "04a53181-61c9-40b9-b54d-5a666255e4b7"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "mcs_flowactivitystatuses",
              "recordId": "@outputs('Create_new_Flow_Activity_Status_Monitoring')?['body/mcs_flowactivitystatusid']",
              "item/mcs_enddatetime": "@body('Current_time_Failed')",
              "item/mcs_errormessage": "@string(outputs('Flow_Error_Message'))",
              "item/statuscode": 153190004
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Update the corresponding Flow Activity Status record due to one or more steps failing in the Scope above.   Update the Start Date field to Current time, Flow Run Status to Error and the Error Message field with the error retrieved from previous step."
        },
        "Initialize_variable": {
          "runAfter": {
            "Initialize_Run_ID_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "a4b22957-28af-4389-b11b-c3543fa911fb"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Create Date",
                "type": "string"
              }
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}