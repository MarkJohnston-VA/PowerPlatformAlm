                  "fetchXml": "<fetch version=\"1.0\" output-format=\"xml-platform\" mapping=\"logical\" distinct=\"true\">\n  <entity name=\"team\">\n    <attribute name=\"name\" />\n    <attribute name=\"teamid\" />\n    <attribute name=\"mcs_vethomeusergroup\" />\n    <order attribute=\"mcs_priority\" descending=\"true\" />\n    <filter type=\"and\">\n      <condition attribute=\"teamtype\" operator=\"ne\" value=\"1\" />\n      <condition attribute=\"businessunitid\" operator=\"eq\" uiname=\"VET-HOME\" uitype=\"businessunit\" value=\"{18AE5E07-8C9D-ED11-AAD0-001DD8072538}\" />\n      <condition attribute=\"mcs_priority\" operator=\"not-null\" />\n      <condition attribute=\"mcs_vethomeusergroup\" operator=\"not-null\" />\n    </filter>\n    <link-entity name=\"teammembership\" from=\"teamid\" to=\"teamid\" visible=\"false\" intersect=\"true\">\n      <link-entity name=\"systemuser\" from=\"systemuserid\" to=\"systemuserid\" alias=\"ah\">\n        <filter type=\"and\">\n          <condition attribute=\"systemuserid\" operator=\"eq\" uitype=\"systemuser\" value=\"@{triggerOutputs()?['body/_createdby_value']}\" />\n        </filter>\n      </link-entity>\n    </link-entity>\n  </entity>\n</fetch>"
