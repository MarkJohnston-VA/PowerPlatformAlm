          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "systemusers",
              "fetchXml": "<fetch version=\"1.0\" output-format=\"xml-platform\" mapping=\"logical\" distinct=\"true\">\n  <entity name=\"systemuser\">\n    <attribute name=\"fullname\" />\n    <attribute name=\"businessunitid\" />\n    <attribute name=\"positionid\" />\n    <attribute name=\"systemuserid\" />\n    <attribute name=\"mcs_lastlogindate\" />\n    <attribute name=\"isdisabled\" />\n    <filter>\n      <condition attribute=\"mcs_lastlogindate\" operator=\"not-null\" />\n      <condition attribute=\"isdisabled\" operator=\"eq\" value=\"0\" />\n    </filter>\n    <order attribute=\"fullname\" descending=\"false\" />\n    <link-entity name=\"vhacrm_hrc_lob_systemuser\" from=\"systemuserid\" to=\"systemuserid\" intersect=\"true\">\n      <attribute name=\"hrc_lobid\" />\n      <attribute name=\"systemuserid\" />\n      <attribute name=\"versionnumber\" />\n      <attribute name=\"vhacrm_hrc_lob_systemuserid\" />\n      <filter>\n        <condition attribute=\"hrc_lobid\" operator=\"eq\" value=\"A9C7B284-F0E3-E611-9427-0050568D1C17\" />\n      </filter>\n    </link-entity>\n  </entity>\n</fetch>"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('List_Users')?['body/value']",
          "actions": {
            "Create_Notification_record": {
              "runAfter": {},
              "metadata": {
