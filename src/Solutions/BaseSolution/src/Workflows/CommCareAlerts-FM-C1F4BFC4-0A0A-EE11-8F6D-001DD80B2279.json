                  "item/title": "@triggerOutputs()?['body/mcs_toastalerttitle']",
                  "item/body": "@triggerOutputs()?['body/mcs_toastalertbody']",
                  "item/data": "{\n  \"actions\": [\n    {\n      \"data\": {\n        \"url\": \"https://dvagov-commcare-mock.crm9.dynamics.com/main.aspx?pagetype=entityrecord&etn=mcs_commcarealert&id=@{triggerOutputs()?['body/mcs_commcarealertid']}&formid=0c460791-f809-ee11-8f6d-001dd80851c2\",\n        \"navigationTarget\": \"newWindow\"\n      },\n      \"title\": \"MORE INFORMATION\"\n    }\n  ]\n}",
                  "item/ttlinseconds": 172800,
                  "item/ownerid@odata.bind": "systemusers(@{items('Apply_to_each')?['systemuserid']})",
                  "item/priority": 200000001,
                  "item/toasttype": 200000000
                },
                "authentication": "@parameters('$authentication')"
              }
            }
