        function uuidv4() {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }

        function defaultValuesForBeneAndVet() {
            //debugger;
            console.log(CommCare.Shared.GetFieldValue("bah_firstname_text"));
            var crmFirstName = CommCare.Shared.GetFieldValue("bah_firstname_text");
            var crmLastName = CommCare.Shared.GetFieldValue("bah_lastname_text");
            var crmSSN = CommCare.Shared.GetFieldValue("bah_ssn_text");
            var crmDOB = CommCare.Shared.GetFieldValue("bah_dob_date");
            var crmIntWithObj = CommCare.Shared.FormContext.data.entity.attributes.get("bah_interactedwith_code");
            var crmIntWith = crmIntWithObj ? crmIntWithObj.getSelectedOption().text : null;
            var wrFname = $("#FirstNameTextBox").val();
            var wrLname = $("#LastNameTextBox").val();
            var wrSSN = $("#SocialSecurityTextBox").val();
            var wrDOB_M = $("#BirthMonthTextBox").val();
            var wrDOB_D = $("#BirthDayTextBox").val();
            var wrDOB_Y = $("#BirthYearTextBox").val();

            try {
                // Only run this if Interacted With = "Veteran"
                if (crmIntWith == "Veteran") {
                    if (wrFname.trim() == "" && crmFirstName != null) {
                        $("#FirstNameTextBox").val(crmFirstName);
                    }
                    if (wrLname.trim() == "" && crmLastName != null) {
                        $("#LastNameTextBox").val(crmLastName);
                    }

                    // include validation on SSN field
                    if (wrSSN.trim() == "" && crmSSN != null) {
                        if (CommCare.Shared.ValidateSSN(crmSSN)) {
                            $("#SocialSecurityTextBox").val(crmSSN);
                        }
                        else {
                            alert("Invalid SSN.  Social Security Number must be 9 numbers and can only contain numbers.");
                        }
                    }

                    if ((wrDOB_M.trim() == "MM" || wrDOB_M.trim() == "") && crmDOB != null) {
                        var BirthDate = new Date(crmDOB);
                        wrDOB_M.value = BirthDate.getMonth() + 1;
                        wrDOB_D.value = BirthDate.getDate();
                        wrDOB_Y.value = BirthDate.getFullYear();

                        $("#BirthMonthTextBox").val(BirthDate.getMonth() + 1);
                        $("#BirthDayTextBox").val(BirthDate.getDate());
                        $("#BirthYearTextBox").val(BirthDate.getFullYear());
                    }

                }
                else if (crmIntWith == "Beneficiary") {
                    if (wrFname.trim() == "" && crmFirstName != null) {
                        $("#FirstNameTextBox").val(crmFirstName);
                    }
                    if (wrLname.trim() == "" && crmLastName != null) {
                        $("#LastNameTextBox").val(crmLastName);
                    }
                }
            }
            catch (e) {
                //alert('Error in refreshMVI(): ' + e.Message);
                console.log("Error in refreshMVI():" + e.Message);
            }
        }
